# F SOCIETY — environment configuration (copy to .env and fill in)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# SECRETS — generate a long random string in production!
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

DB_PATH=./data/f_society.db
UPLOADS_DIR=./uploads

# Per-type upload limits (bytes). MAX_UPLOAD_BYTES is the absolute multer ceiling.
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_BYTES=8388608
MAX_DOC_BYTES=15728640

APP_URL=http://localhost:3000

# Storage backend: 'local' (development) or 's3' (production object storage).
# S3 credentials are read from the standard AWS_*/S3_* env vars by @aws-sdk/client-s3.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# In development we surface verify/reset tokens directly instead of emailing.
DEV_BYPASS_EMAIL=true
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Seed admin (created on first boot if missing)
SEED_ADMIN_EMAIL=root@f.society
SEED_ADMIN_PASSWORD=F_Society#2024!
